<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Ab Android 12: Selbst-Update ohne zusätzliche Rückfrage, sofern das System es erlaubt -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <!-- Letterboxd-Anmeldung (echte Letterboxd-Seite in einer WebView) -->
        <activity
            android:name="de.aniworld.tv.platform.LetterboxdSignInActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <receiver
            android:name="de.aniworld.tv.data.update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
